# Secret de signature des sessions, liens et clés MCP (32 caractères minimum).
# Le changer révoque toutes les sessions et toutes les clés MCP.
SILLAGE_SECRET=
# Qui peut ouvrir un espace : "*" (ouvert) ou e-mails séparés par des virgules.
SILLAGE_INSCRIPTIONS=
# Nom affiché comme expéditeur et en signature des relances.
SILLAGE_EXPEDITEUR=
SILLAGE_URL=

# Firestore : JSON du compte de service encodé en base64. Absent = stockage en mémoire (dev).
FIREBASE_SERVICE_ACCOUNT_B64=

# Envoi des e-mails (Gmail + mot de passe d'application).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Objectif « une contribution publique par jour » (lecture seule suffit).
GITHUB_LOGIN=
GITHUB_TOKEN=
